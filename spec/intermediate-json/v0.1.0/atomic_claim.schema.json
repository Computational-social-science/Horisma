{
  "$id": "https://horisma.invalid/contracts/intermediate/0.1.0/atomic_claim.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Structural interchange for dictionary entity atomic_claim. Conformance does not certify review, truth, rights or implementation.",
  "properties": {
    "definition_stage": {
      "const": "CORE_CONTRACT_DEFINED"
    },
    "record": {
      "additionalProperties": false,
      "properties": {
        "concept_ref": {
          "$ref": "shared.schema.json#/$defs/RecordRef",
          "description": "Concept/sense to which the proposition applies.",
          "x-logical-type": "ref:concept",
          "x-target-type": "concept"
        },
        "created_at": {
          "format": "date-time",
          "type": "string"
        },
        "created_by_actor_ref": {
          "$ref": "shared.schema.json#/$defs/RecordRef"
        },
        "derived_from_claim_refs": {
          "anyOf": [
            {
              "items": {
                "$ref": "shared.schema.json#/$defs/RecordRef"
              },
              "minItems": 0,
              "type": "array",
              "x-target-type": "atomic_claim"
            },
            {
              "type": "null"
            }
          ],
          "description": "Logical/processing dependency, not independent corroboration.",
          "x-logical-type": "refs:atomic_claim"
        },
        "dictionary_version": {
          "const": "0.1.0"
        },
        "disclosure_class": {
          "$ref": "shared.schema.json#/$defs/v_disclosure_class"
        },
        "entity_id": {
          "pattern": "^atomic_claim:[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "type": "string"
        },
        "logical_statement_ref": {
          "anyOf": [
            {
              "$ref": "shared.schema.json#/$defs/RecordRef",
              "x-target-type": "logical_statement"
            },
            {
              "type": "null"
            }
          ],
          "description": "Optional formal encoding, not a proof of historical truth.",
          "x-logical-type": "ref:logical_statement"
        },
        "missing_reasons": {
          "additionalProperties": {
            "$ref": "shared.schema.json#/$defs/v_missing_reason"
          },
          "type": "object"
        },
        "origin": {
          "$ref": "shared.schema.json#/$defs/v_assertion_origin",
          "description": "Wikipedia/legacy/model proposals do not inherit acceptance.",
          "x-logical-type": "enum"
        },
        "proposition": {
          "description": "Retain original wording; a question or report is not an asserted fact.",
          "minLength": 1,
          "type": "string",
          "x-logical-type": "text"
        },
        "provenance_artifact_refs": {
          "items": {
            "$ref": "shared.schema.json#/$defs/RecordRef"
          },
          "type": "array"
        },
        "record_id": {
          "$ref": "shared.schema.json#/$defs/RecordRef"
        },
        "record_status": {
          "$ref": "shared.schema.json#/$defs/v_record_status"
        },
        "record_version": {
          "minimum": 1,
          "type": "integer"
        },
        "scope_statement": {
          "description": "Bounded proposition; no silent universalization.",
          "minLength": 1,
          "type": "string",
          "x-logical-type": "text"
        },
        "search_scope_ref": {
          "anyOf": [
            {
              "$ref": "shared.schema.json#/$defs/RecordRef",
              "x-target-type": "search_scope"
            },
            {
              "type": "null"
            }
          ],
          "description": "Mandatory for earliest/absence claims.",
          "x-logical-type": "ref:search_scope"
        },
        "supersedes_record_id": {
          "anyOf": [
            {
              "$ref": "shared.schema.json#/$defs/RecordRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "vocabulary_version": {
          "const": "0.1.0"
        }
      },
      "required": [
        "entity_id",
        "record_id",
        "record_version",
        "dictionary_version",
        "vocabulary_version",
        "record_status",
        "created_at",
        "created_by_actor_ref",
        "disclosure_class",
        "missing_reasons",
        "provenance_artifact_refs",
        "proposition",
        "concept_ref",
        "scope_statement",
        "origin"
      ],
      "type": "object"
    },
    "record_type": {
      "const": "atomic_claim"
    },
    "schema_profile": {
      "const": "horisma-dictionary-structural-0.1.0"
    }
  },
  "required": [
    "schema_profile",
    "record_type",
    "definition_stage",
    "record"
  ],
  "type": "object",
  "x-dictionary-sha256": "bfd1eaf0e8ba683e0aac0a5cbd0ffb77f455f6bb66d16160bd0906d2b6a96cd8",
  "x-semantic-conditions": [],
  "x-vocabulary-sha256": "01a5153a00f7b938b1db13ba99e25f5bef080e4ba90156238c568536bedc6a27"
