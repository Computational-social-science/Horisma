{
  "$id": "https://horisma.invalid/contracts/intermediate/0.1.0/adjudication.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Structural interchange for dictionary entity adjudication. Conformance does not certify review, truth, rights or implementation.",
  "properties": {
    "definition_stage": {
      "const": "CORE_CONTRACT_DEFINED"
    },
    "record": {
      "additionalProperties": false,
      "properties": {
        "annotation_refs": {
          "description": "Independent decisions; retain disagreements.",
          "items": {
            "$ref": "shared.schema.json#/$defs/RecordRef"
          },
          "minItems": 1,
          "type": "array",
          "x-logical-type": "refs:annotation",
          "x-target-type": "annotation"
        },
        "assessment": {
          "anyOf": [
            {
              "$ref": "shared.schema.json#/$defs/v_claim_assessment"
            },
            {
              "type": "null"
            }
          ],
          "description": "Completed assessment label; null with reason before completion.",
          "x-logical-type": "enum"
        },
        "claim_ref": {
          "$ref": "shared.schema.json#/$defs/RecordRef",
          "description": "Target with fixed scope.",
          "x-logical-type": "ref:atomic_claim",
          "x-target-type": "atomic_claim"
        },
        "created_at": {
          "format": "date-time",
          "type": "string"
        },
        "created_by_actor_ref": {
          "$ref": "shared.schema.json#/$defs/RecordRef"
        },
        "dictionary_version": {
          "const": "0.1.0"
        },
        "disagreement_resolution": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Needed when annotations differ; agreement is not proof of truth.",
          "x-logical-type": "text"
        },
        "disclosure_class": {
          "$ref": "shared.schema.json#/$defs/v_disclosure_class"
        },
        "entity_id": {
          "pattern": "^adjudication:[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "type": "string"
        },
        "missing_reasons": {
          "additionalProperties": {
            "$ref": "shared.schema.json#/$defs/v_missing_reason"
          },
          "type": "object"
        },
        "policy_ref": {
          "$ref": "shared.schema.json#/$defs/RecordRef",
          "description": "Applied rules, not a mutable policy name.",
          "x-logical-type": "ref:adjudication_policy",
          "x-target-type": "adjudication_policy"
        },
        "provenance_artifact_refs": {
          "items": {
            "$ref": "shared.schema.json#/$defs/RecordRef"
          },
          "type": "array"
        },
        "record_id": {
          "$ref": "shared.schema.json#/$defs/RecordRef"
        },
        "record_status": {
          "$ref": "shared.schema.json#/$defs/v_record_status"
        },
        "record_version": {
          "minimum": 1,
          "type": "integer"
        },
        "supersedes_record_id": {
          "anyOf": [
            {
              "$ref": "shared.schema.json#/$defs/RecordRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "vocabulary_version": {
          "const": "0.1.0"
        }
      },
      "required": [
        "entity_id",
        "record_id",
        "record_version",
        "dictionary_version",
        "vocabulary_version",
        "record_status",
        "created_at",
        "created_by_actor_ref",
        "disclosure_class",
        "missing_reasons",
        "provenance_artifact_refs",
        "claim_ref",
        "policy_ref",
        "annotation_refs"
      ],
      "type": "object"
    },
    "record_type": {
      "const": "adjudication"
    },
    "schema_profile": {
      "const": "horisma-dictionary-structural-0.1.0"
    }
  },
  "required": [
    "schema_profile",
    "record_type",
    "definition_stage",
    "record"
  ],
  "type": "object",
  "x-dictionary-sha256": "bfd1eaf0e8ba683e0aac0a5cbd0ffb77f455f6bb66d16160bd0906d2b6a96cd8",
  "x-semantic-conditions": [],
  "x-vocabulary-sha256": "01a5153a00f7b938b1db13ba99e25f5bef080e4ba90156238c568536bedc6a27"
}