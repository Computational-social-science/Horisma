          "x-target-type": "document_version"
        },
        "entity_id": {
          "pattern": "^human_source_request:[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "type": "string"
        },
        "failure_kind": {
