{
  "$id": "https://horisma.invalid/contracts/intermediate/0.1.0/evidence_link.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Structural interchange for dictionary entity evidence_link. Conformance does not certify review, truth, rights or implementation.",
  "properties": {
    "definition_stage": {
      "const": "CORE_CONTRACT_DEFINED"
    },
    "record": {
      "additionalProperties": false,
      "properties": {
        "claim_ref": {
          "$ref": "shared.schema.json#/$defs/RecordRef",
          "description": "Precisely assessed proposition.",
          "x-logical-type": "ref:atomic_claim",
          "x-target-type": "atomic_claim"
        },
        "created_at": {
          "format": "date-time",
          "type": "string"
        },
        "created_by_actor_ref": {
          "$ref": "shared.schema.json#/$defs/RecordRef"
        },
        "dictionary_version": {
          "const": "0.1.0"
        },
        "disclosure_class": {
          "$ref": "shared.schema.json#/$defs/v_disclosure_class"
        },
        "entity_id": {
          "pattern": "^evidence_link:[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "type": "string"
        },
        "missing_reasons": {
          "additionalProperties": {
            "$ref": "shared.schema.json#/$defs/v_missing_reason"
          },
          "type": "object"
        },
        "passage_ref": {
          "$ref": "shared.schema.json#/$defs/RecordRef",
          "description": "Evidence location; citation existence alone is insufficient.",
          "x-logical-type": "ref:passage",
          "x-target-type": "passage"
        },
        "policy_ref": {
          "$ref": "shared.schema.json#/$defs/RecordRef",
          "description": "Rules used to interpret passage support.",
          "x-logical-type": "ref:adjudication_policy",
          "x-target-type": "adjudication_policy"
        },
        "provenance_artifact_refs": {
          "items": {
            "$ref": "shared.schema.json#/$defs/RecordRef"
          },
          "type": "array"
        },
        "rationale": {
          "description": "Explain support and its limits; no numeric self-confidence substitute.",
          "minLength": 1,
          "type": "string",
          "x-logical-type": "text"
        },
        "record_id": {
          "$ref": "shared.schema.json#/$defs/RecordRef"
        },
        "record_status": {
          "$ref": "shared.schema.json#/$defs/v_record_status"
        },
        "record_version": {
          "minimum": 1,
          "type": "integer"
        },
        "relation": {
          "$ref": "shared.schema.json#/$defs/v_evidence_relation",
          "description": "Mentions/reports must not be promoted to direct support.",
          "x-logical-type": "enum"
        },
        "supersedes_record_id": {
          "anyOf": [
            {
              "$ref": "shared.schema.json#/$defs/RecordRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "vocabulary_version": {
          "const": "0.1.0"
        }
      },
      "required": [
        "entity_id",
        "record_id",
        "record_version",
        "dictionary_version",
        "vocabulary_version",
        "record_status",
        "created_at",
        "created_by_actor_ref",
        "disclosure_class",
        "missing_reasons",
        "provenance_artifact_refs",
        "passage_ref",
        "claim_ref",
        "relation",
        "policy_ref",
        "rationale"
      ],
      "type": "object"
    },
    "record_type": {
      "const": "evidence_link"
    },
    "schema_profile": {
      "const": "horisma-dictionary-structural-0.1.0"
    }
  },
  "required": [
    "schema_profile",
    "record_type",
    "definition_stage",
    "record"
  ],
  "type": "object",
  "x-dictionary-sha256": "bfd1eaf0e8ba683e0aac0a5cbd0ffb77f455f6bb66d16160bd0906d2b6a96cd8",
  "x-semantic-conditions": [],
