        },
        "sampled_at": {
          "description": "Fresh observation time, not research-result time.",
          "format": "date-time",
          "type": "string",
          "x-logical-type": "datetime"
        },
        "supersedes_record_id": {
          "anyOf": [
            {
              "$ref": "shared.schema.json#/$defs/RecordRef"
            },
            {
              "type": "null"
