{
  "$id": "https://horisma.invalid/contracts/intermediate/0.1.0/artifact.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Structural interchange for dictionary entity artifact. Conformance does not certify review, truth, rights or implementation.",
  "properties": {
    "definition_stage": {
      "const": "CORE_CONTRACT_DEFINED"
    },
    "record": {
      "additionalProperties": false,
      "properties": {
        "created_at": {
          "format": "date-time",
          "type": "string"
        },
        "created_by_actor_ref": {
          "$ref": "shared.schema.json#/$defs/RecordRef"
        },
        "dependency_refs": {
          "anyOf": [
            {
              "items": {
                "$ref": "shared.schema.json#/$defs/RecordRef"
              },
              "minItems": 0,
              "type": "array",
              "x-target-type": "artifact"
            },
            {
              "type": "null"
            }
          ],
          "description": "Explicit transitive dependencies; no self/circular derivation.",
          "x-logical-type": "refs:artifact"
        },
        "dictionary_version": {
          "const": "0.1.0"
        },
        "disclosure_class": {
          "$ref": "shared.schema.json#/$defs/v_disclosure_class"
        },
        "entity_id": {
          "pattern": "^artifact:[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "type": "string"
        },
        "kind": {
          "description": "For example source PDF, OCR, book, model weights or illustration.",
          "minLength": 1,
          "type": "string",
          "x-logical-type": "text"
        },
        "missing_reasons": {
          "additionalProperties": {
            "$ref": "shared.schema.json#/$defs/v_missing_reason"
          },
          "type": "object"
        },
        "provenance_artifact_refs": {
          "items": {
            "$ref": "shared.schema.json#/$defs/RecordRef"
          },
          "type": "array"
        },
        "public_projection_of_ref": {
          "anyOf": [
            {
              "$ref": "shared.schema.json#/$defs/RecordRef",
              "x-target-type": "artifact"
            },
            {
              "type": "null"
            }
          ],
          "description": "Explicit reviewed public projection; underlying private source does not become public.",
          "x-logical-type": "ref:artifact"
        },
        "record_id": {
          "$ref": "shared.schema.json#/$defs/RecordRef"
        },
        "record_status": {
          "$ref": "shared.schema.json#/$defs/v_record_status"
        },
        "record_version": {
          "minimum": 1,
          "type": "integer"
        },
        "relative_path": {
          "description": "No traversal, credential path or EIDOS scientific state.",
          "minLength": 1,
          "type": "string",
          "x-logical-type": "path"
        },
        "rights_decision_refs": {
          "anyOf": [
            {
              "items": {
                "$ref": "shared.schema.json#/$defs/RecordRef"
              },
              "minItems": 0,
              "type": "array",
              "x-target-type": "rights_decision"
            },
            {
              "type": "null"
            }
          ],
          "description": "Per-operation permissions for included components.",
          "x-logical-type": "refs:rights_decision"
        },
        "sha256": {
          "$ref": "shared.schema.json#/$defs/sha256",
          "description": "Digest does not prove source authenticity or science.",
          "x-logical-type": "sha256"
        },
        "supersedes_record_id": {
          "anyOf": [
            {
              "$ref": "shared.schema.json#/$defs/RecordRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "vocabulary_version": {
          "const": "0.1.0"
        }
      },
      "required": [
        "entity_id",
        "record_id",
        "record_version",
        "dictionary_version",
        "vocabulary_version",
        "record_status",
        "created_at",
        "created_by_actor_ref",
        "disclosure_class",
        "missing_reasons",
        "provenance_artifact_refs",
        "kind",
        "relative_path",
        "sha256"
      ],
      "type": "object"
    },
    "record_type": {
      "const": "artifact"
    },
    "schema_profile": {
      "const": "horisma-dictionary-structural-0.1.0"
    }
  },
  "required": [
    "schema_profile",
    "record_type",
    "definition_stage",
    "record"
  ],
  "type": "object",
  "x-dictionary-sha256": "bfd1eaf0e8ba683e0aac0a5cbd0ffb77f455f6bb66d16160bd0906d2b6a96cd8",
  "x-semantic-conditions": [],
  "x-vocabulary-sha256": "01a5153a00f7b938b1db13ba99e25f5bef080e4ba90156238c568536bedc6a27"
}