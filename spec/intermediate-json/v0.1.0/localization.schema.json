{
  "$id": "https://horisma.invalid/contracts/intermediate/0.1.0/localization.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Structural interchange for dictionary entity localization. Conformance does not certify review, truth, rights or implementation.",
  "properties": {
    "definition_stage": {
      "const": "PROPOSED"
    },
    "record": {
      "additionalProperties": false,
      "properties": {
        "created_at": {
          "format": "date-time",
          "type": "string"
        },
        "created_by_actor_ref": {
          "$ref": "shared.schema.json#/$defs/RecordRef"
        },
        "dictionary_version": {
          "const": "0.1.0"
        },
        "disclosure_class": {
          "$ref": "shared.schema.json#/$defs/v_disclosure_class"
        },
        "entity_id": {
          "pattern": "^localization:[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "type": "string"
        },
        "locale_review_ref": {
          "anyOf": [
            {
              "$ref": "shared.schema.json#/$defs/RecordRef",
              "x-target-type": "review_decision"
            },
            {
              "type": "null"
            }
          ],
          "description": "Back-translation/model fluency is not independent approval.",
          "x-logical-type": "ref:review_decision"
        },
        "missing_reasons": {
          "additionalProperties": {
            "$ref": "shared.schema.json#/$defs/v_missing_reason"
          },
          "type": "object"
        },
        "parent_book_ref": {
          "$ref": "shared.schema.json#/$defs/RecordRef",
          "description": "Do not translate an unbound changing draft.",
          "x-logical-type": "ref:book_edition",
          "x-target-type": "book_edition"
        },
        "preserved_claim_refs": {
          "description": "Claim identities, uncertainty and roles survive translation.",
          "items": {
            "$ref": "shared.schema.json#/$defs/RecordRef"
          },
          "minItems": 1,
          "type": "array",
          "x-logical-type": "refs:atomic_claim",
          "x-target-type": "atomic_claim"
        },
        "provenance_artifact_refs": {
          "items": {
            "$ref": "shared.schema.json#/$defs/RecordRef"
          },
          "type": "array"
        },
        "record_id": {
          "$ref": "shared.schema.json#/$defs/RecordRef"
        },
        "record_status": {
          "$ref": "shared.schema.json#/$defs/v_record_status"
        },
        "record_version": {
          "minimum": 1,
          "type": "integer"
        },
        "supersedes_record_id": {
          "anyOf": [
            {
              "$ref": "shared.schema.json#/$defs/RecordRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "target_language": {
          "$ref": "shared.schema.json#/$defs/v_target_language",
          "description": "Six planned publication lanes, each separately reviewed.",
          "x-logical-type": "enum"
        },
        "translated_artifact_ref": {
          "$ref": "shared.schema.json#/$defs/RecordRef",
          "description": "Source-language quotations remain separately accessible.",
          "x-logical-type": "ref:artifact",
          "x-target-type": "artifact"
        },
        "vocabulary_version": {
          "const": "0.1.0"
        }
      },
      "required": [
        "entity_id",
        "record_id",
        "record_version",
        "dictionary_version",
        "vocabulary_version",
        "record_status",
        "created_at",
        "created_by_actor_ref",
        "disclosure_class",
        "missing_reasons",
        "provenance_artifact_refs",
        "parent_book_ref",
        "target_language",
        "preserved_claim_refs",
        "translated_artifact_ref"
      ],
      "type": "object"
    },
    "record_type": {
      "const": "localization"
    },
    "schema_profile": {
      "const": "horisma-dictionary-structural-0.1.0"
    }
  },
  "required": [
    "schema_profile",
    "record_type",
    "definition_stage",
    "record"
  ],
  "type": "object",
  "x-dictionary-sha256": "bfd1eaf0e8ba683e0aac0a5cbd0ffb77f455f6bb66d16160bd0906d2b6a96cd8",
  "x-semantic-conditions": [],
  "x-vocabulary-sha256": "01a5153a00f7b938b1db13ba99e25f5bef080e4ba90156238c568536bedc6a27"
}