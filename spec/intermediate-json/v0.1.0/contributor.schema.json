{
  "$id": "https://horisma.invalid/contracts/intermediate/0.1.0/contributor.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Structural interchange for dictionary entity contributor. Conformance does not certify review, truth, rights or implementation.",
  "properties": {
    "definition_stage": {
      "const": "CORE_CONTRACT_DEFINED"
    },
    "record": {
      "additionalProperties": false,
      "properties": {
        "created_at": {
          "format": "date-time",
          "type": "string"
        },
        "created_by_actor_ref": {
          "$ref": "shared.schema.json#/$defs/RecordRef"
        },
        "dictionary_version": {
          "const": "0.1.0"
        },
        "disclosure_class": {
          "$ref": "shared.schema.json#/$defs/v_disclosure_class"
        },
        "display_name": {
          "description": "Name for presentation, not a merge key or proof of identity.",
          "minLength": 1,
          "type": "string",
          "x-logical-type": "text"
        },
        "entity_id": {
          "pattern": "^contributor:[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "type": "string"
        },
        "identifier_values": {
          "anyOf": [
            {
              "$ref": "shared.schema.json#/$defs/IdentifierList"
            },
            {
              "type": "null"
            }
          ],
          "description": "ORCID/other identifiers if actually established.",
          "x-logical-type": "IdentifierList"
        },
        "identity_assertion_refs": {
          "anyOf": [
            {
              "items": {
                "$ref": "shared.schema.json#/$defs/RecordRef"
              },
              "minItems": 0,
              "type": "array",
              "x-target-type": "identity_assertion"
            },
            {
              "type": "null"
            }
          ],
          "description": "Dated sourced biography; no inference from portraits/flags.",
          "x-logical-type": "refs:identity_assertion"
        },
        "kind": {
          "$ref": "shared.schema.json#/$defs/v_contributor_kind",
          "description": "Entity kind; unknown is not automatically a person.",
          "x-logical-type": "enum"
        },
        "missing_reasons": {
          "additionalProperties": {
            "$ref": "shared.schema.json#/$defs/v_missing_reason"
          },
          "type": "object"
        },
        "provenance_artifact_refs": {
          "items": {
            "$ref": "shared.schema.json#/$defs/RecordRef"
          },
          "type": "array"
        },
        "record_id": {
          "$ref": "shared.schema.json#/$defs/RecordRef"
        },
        "record_status": {
          "$ref": "shared.schema.json#/$defs/v_record_status"
        },
        "record_version": {
          "minimum": 1,
          "type": "integer"
        },
        "supersedes_record_id": {
          "anyOf": [
            {
              "$ref": "shared.schema.json#/$defs/RecordRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "vocabulary_version": {
          "const": "0.1.0"
        }
      },
      "required": [
        "entity_id",
        "record_id",
        "record_version",
        "dictionary_version",
        "vocabulary_version",
        "record_status",
        "created_at",
        "created_by_actor_ref",
        "disclosure_class",
        "missing_reasons",
        "provenance_artifact_refs",
        "kind",
        "display_name"
      ],
      "type": "object"
    },
    "record_type": {
      "const": "contributor"
    },
    "schema_profile": {
      "const": "horisma-dictionary-structural-0.1.0"
    }
  },
  "required": [
    "schema_profile",
    "record_type",
    "definition_stage",
    "record"
  ],
  "type": "object",
  "x-dictionary-sha256": "bfd1eaf0e8ba683e0aac0a5cbd0ffb77f455f6bb66d16160bd0906d2b6a96cd8",
  "x-semantic-conditions": [],
  "x-vocabulary-sha256": "01a5153a00f7b938b1db13ba99e25f5bef080e4ba90156238c568536bedc6a27"
}