{
  "$id": "https://horisma.invalid/contracts/intermediate/0.1.0/model_response.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Structural interchange for dictionary entity model_response. Conformance does not certify review, truth, rights or implementation.",
  "properties": {
    "definition_stage": {
      "const": "PROTOCOL_DEPENDENT"
    },
    "record": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "calibrated_correctness_probability": {
                "not": {
                  "type": "null"
                }
              }
            },
            "required": [
              "calibrated_correctness_probability"
            ]
          },
          "then": {
            "properties": {
              "calibration_ref": {
                "not": {
                  "type": "null"
                }
              }
            },
            "required": [
              "calibration_ref"
            ]
          }
        }
      ],
      "properties": {
        "answer_artifact_ref": {
          "$ref": "shared.schema.json#/$defs/RecordRef",
          "description": "Retain failed/malformed answers and attempts.",
          "x-logical-type": "ref:artifact",
          "x-target-type": "artifact"
        },
        "calibrated_correctness_probability": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "description": "Requires a bound independent calibration study for this task/outcome and evaluation condition; never historical truth probability.",
          "x-logical-type": "fraction"
        },
        "calibration_ref": {
          "anyOf": [
            {
              "$ref": "shared.schema.json#/$defs/RecordRef",
              "x-target-type": "artifact"
            },
            {
              "type": "null"
            }
          ],
          "description": "Absent is not a calibrated score of zero.",
          "x-logical-type": "ref:artifact"
        },
        "configuration_ref": {
          "$ref": "shared.schema.json#/$defs/RecordRef",
          "description": "Actual selected local configuration.",
          "x-logical-type": "ref:model_configuration",
          "x-target-type": "model_configuration"
        },
        "created_at": {
          "format": "date-time",
          "type": "string"
        },
        "created_by_actor_ref": {
          "$ref": "shared.schema.json#/$defs/RecordRef"
        },
        "dictionary_version": {
          "const": "0.1.0"
        },
        "disclosure_class": {
          "$ref": "shared.schema.json#/$defs/v_disclosure_class"
        },
        "entity_id": {
          "pattern": "^model_response:[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "type": "string"
        },
        "evaluation_context_ref": {
          "$ref": "shared.schema.json#/$defs/RecordRef",
          "description": "Bind the frozen release, gold/scoring policy and actually accessible prompt/evidence; no ambiguous cross-release scoring.",
          "x-logical-type": "ref:evaluation_context",
          "x-target-type": "evaluation_context"
        },
        "missing_reasons": {
          "additionalProperties": {
            "$ref": "shared.schema.json#/$defs/v_missing_reason"
          },
          "type": "object"
        },
        "provenance_artifact_refs": {
          "items": {
            "$ref": "shared.schema.json#/$defs/RecordRef"
          },
          "type": "array"
        },
        "raw_self_rating": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "description": "Optional requested score; never called historical truth probability.",
          "x-logical-type": "fraction"
        },
        "record_id": {
          "$ref": "shared.schema.json#/$defs/RecordRef"
        },
        "record_status": {
          "$ref": "shared.schema.json#/$defs/v_record_status"
        },
        "record_version": {
          "minimum": 1,
          "type": "integer"
        },
        "supersedes_record_id": {
          "anyOf": [
            {
              "$ref": "shared.schema.json#/$defs/RecordRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "task_ref": {
          "$ref": "shared.schema.json#/$defs/RecordRef",
          "description": "Task/condition and eligible gold policy.",
          "x-logical-type": "ref:benchmark_task",
          "x-target-type": "benchmark_task"
        },
        "token_softmax_artifact_ref": {
          "anyOf": [
            {
              "$ref": "shared.schema.json#/$defs/RecordRef",
              "x-target-type": "artifact"
            },
            {
              "type": "null"
            }
          ],
          "description": "Raw token probabilities with tokenizer/logit-processing/dtype configuration; not a calibrated answer correctness probability.",
          "x-logical-type": "ref:artifact"
        },
        "vocabulary_version": {
          "const": "0.1.0"
        }
      },
      "required": [
        "entity_id",
        "record_id",
        "record_version",
        "dictionary_version",
        "vocabulary_version",
        "record_status",
        "created_at",
        "created_by_actor_ref",
        "disclosure_class",
        "missing_reasons",
        "provenance_artifact_refs",
        "task_ref",
        "configuration_ref",
        "answer_artifact_ref",
        "evaluation_context_ref"
      ],
      "type": "object"
    },
    "record_type": {
      "const": "model_response"
    },
    "schema_profile": {
      "const": "horisma-dictionary-structural-0.1.0"
    }
  },
  "required": [
    "schema_profile",
    "record_type",
    "definition_stage",
    "record"
  ],
  "type": "object",
  "x-dictionary-sha256": "bfd1eaf0e8ba683e0aac0a5cbd0ffb77f455f6bb66d16160bd0906d2b6a96cd8",
  "x-semantic-conditions": [
    {
      "condition": "calibrated_correctness_probability is non-null",
      "field": "calibration_ref",
      "implementation": "JSON_SCHEMA_CONDITION"
    }
  ],
  "x-vocabulary-sha256": "01a5153a00f7b938b1db13ba99e25f5bef080e4ba90156238c568536bedc6a27"
}