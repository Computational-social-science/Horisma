{
  "$id": "https://horisma.invalid/contracts/intermediate/0.1.0/source_file.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Structural interchange for dictionary entity source_file. Conformance does not certify review, truth, rights or implementation.",
  "properties": {
    "definition_stage": {
      "const": "CORE_CONTRACT_DEFINED"
    },
    "record": {
      "additionalProperties": false,
      "properties": {
        "artifact_ref": {
          "$ref": "shared.schema.json#/$defs/RecordRef",
          "description": "Source-file and artifact wrappers must bind identical bytes/digest and resolved payload path, enabling operation-specific rights review.",
          "x-logical-type": "ref:artifact",
          "x-target-type": "artifact"
        },
        "byte_count": {
          "description": "Observed file length; empty files are not usable PDFs.",
          "type": "integer",
          "x-logical-type": "integer"
        },
        "created_at": {
          "format": "date-time",
          "type": "string"
        },
        "created_by_actor_ref": {
          "$ref": "shared.schema.json#/$defs/RecordRef"
        },
        "dictionary_version": {
          "const": "0.1.0"
        },
        "disclosure_class": {
          "$ref": "shared.schema.json#/$defs/v_disclosure_class"
        },
        "document_version_ref": {
          "$ref": "shared.schema.json#/$defs/RecordRef",
          "description": "Version the bytes claim to represent.",
          "x-logical-type": "ref:document_version",
          "x-target-type": "document_version"
        },
        "entity_id": {
          "pattern": "^source_file:[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "type": "string"
        },
        "missing_reasons": {
          "additionalProperties": {
            "$ref": "shared.schema.json#/$defs/v_missing_reason"
          },
          "type": "object"
        },
        "provenance_artifact_refs": {
          "items": {
            "$ref": "shared.schema.json#/$defs/RecordRef"
          },
          "type": "array"
        },
        "record_id": {
          "$ref": "shared.schema.json#/$defs/RecordRef"
        },
        "record_status": {
          "$ref": "shared.schema.json#/$defs/v_record_status"
        },
        "record_version": {
          "minimum": 1,
          "type": "integer"
        },
        "relative_path": {
          "description": "Never an EIDOS state path or a publication permission.",
          "minLength": 1,
          "type": "string",
          "x-logical-type": "path"
        },
        "rights_decision_refs": {
          "anyOf": [
            {
              "items": {
                "$ref": "shared.schema.json#/$defs/RecordRef"
              },
              "minItems": 0,
              "type": "array",
              "x-target-type": "rights_decision"
            },
            {
              "type": "null"
            }
          ],
          "description": "Separate local-processing and redistribution decisions.",
          "x-logical-type": "refs:rights_decision"
        },
        "sha256": {
          "$ref": "shared.schema.json#/$defs/sha256",
          "description": "Content hash, not identity or scientific authentication.",
          "x-logical-type": "sha256"
        },
        "supersedes_record_id": {
          "anyOf": [
            {
              "$ref": "shared.schema.json#/$defs/RecordRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "vocabulary_version": {
          "const": "0.1.0"
        }
      },
      "required": [
        "entity_id",
        "record_id",
        "record_version",
        "dictionary_version",
        "vocabulary_version",
        "record_status",
        "created_at",
        "created_by_actor_ref",
        "disclosure_class",
        "missing_reasons",
        "provenance_artifact_refs",
        "document_version_ref",
        "relative_path",
        "sha256",
        "byte_count",
        "artifact_ref"
      ],
      "type": "object"
    },
    "record_type": {
      "const": "source_file"
    },
    "schema_profile": {
      "const": "horisma-dictionary-structural-0.1.0"
    }
  },
  "required": [
    "schema_profile",
    "record_type",
    "definition_stage",
    "record"
  ],
  "type": "object",
  "x-dictionary-sha256": "bfd1eaf0e8ba683e0aac0a5cbd0ffb77f455f6bb66d16160bd0906d2b6a96cd8",
  "x-semantic-conditions": [],
  "x-vocabulary-sha256": "01a5153a00f7b938b1db13ba99e25f5bef080e4ba90156238c568536bedc6a27"
}