{
  "$id": "https://horisma.invalid/contracts/intermediate/0.1.0/search_scope.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Structural interchange for dictionary entity search_scope. Conformance does not certify review, truth, rights or implementation.",
  "properties": {
    "definition_stage": {
      "const": "CORE_CONTRACT_DEFINED"
    },
    "record": {
      "additionalProperties": false,
      "properties": {
        "corpus_manifest_ref": {
          "$ref": "shared.schema.json#/$defs/RecordRef",
          "description": "Explicit included documents and their versions.",
          "x-logical-type": "ref:artifact",
          "x-target-type": "artifact"
        },
        "coverage_limits": {
          "description": "OCR, language, access and collection gaps remain visible.",
          "minLength": 1,
          "type": "string",
          "x-logical-type": "text"
        },
        "created_at": {
          "format": "date-time",
          "type": "string"
        },
        "created_by_actor_ref": {
          "$ref": "shared.schema.json#/$defs/RecordRef"
        },
        "dictionary_version": {
          "const": "0.1.0"
        },
        "disclosure_class": {
          "$ref": "shared.schema.json#/$defs/v_disclosure_class"
        },
        "entity_id": {
          "pattern": "^search_scope:[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "type": "string"
        },
        "missing_reasons": {
          "additionalProperties": {
            "$ref": "shared.schema.json#/$defs/v_missing_reason"
          },
          "type": "object"
        },
        "provenance_artifact_refs": {
          "items": {
            "$ref": "shared.schema.json#/$defs/RecordRef"
          },
          "type": "array"
        },
        "query_artifact_ref": {
          "$ref": "shared.schema.json#/$defs/RecordRef",
          "description": "Queries, variants, language coverage and attempted sources.",
          "x-logical-type": "ref:artifact",
          "x-target-type": "artifact"
        },
        "record_id": {
          "$ref": "shared.schema.json#/$defs/RecordRef"
        },
        "record_status": {
          "$ref": "shared.schema.json#/$defs/v_record_status"
        },
        "record_version": {
          "minimum": 1,
          "type": "integer"
        },
        "searched_all_declared_material": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "description": "True concerns only the declared corpus, never all history.",
          "x-logical-type": "boolean"
        },
        "supersedes_record_id": {
          "anyOf": [
            {
              "$ref": "shared.schema.json#/$defs/RecordRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "temporal_coverage": {
          "anyOf": [
            {
              "$ref": "shared.schema.json#/$defs/TemporalExtent"
            },
            {
              "type": "null"
            }
          ],
          "description": "Declared search period; not the event time.",
          "x-logical-type": "TemporalExtent"
        },
        "vocabulary_version": {
          "const": "0.1.0"
        }
      },
      "required": [
        "entity_id",
        "record_id",
        "record_version",
        "dictionary_version",
        "vocabulary_version",
        "record_status",
        "created_at",
        "created_by_actor_ref",
        "disclosure_class",
        "missing_reasons",
        "provenance_artifact_refs",
        "corpus_manifest_ref",
        "query_artifact_ref",
        "coverage_limits"
      ],
      "type": "object"
    },
    "record_type": {
      "const": "search_scope"
    },
    "schema_profile": {
      "const": "horisma-dictionary-structural-0.1.0"
    }
  },
  "required": [
    "schema_profile",
    "record_type",
    "definition_stage",
    "record"
  ],
  "type": "object",
  "x-dictionary-sha256": "bfd1eaf0e8ba683e0aac0a5cbd0ffb77f455f6bb66d16160bd0906d2b6a96cd8",
  "x-semantic-conditions": [],
  "x-vocabulary-sha256": "01a5153a00f7b938b1db13ba99e25f5bef080e4ba90156238c568536bedc6a27"
