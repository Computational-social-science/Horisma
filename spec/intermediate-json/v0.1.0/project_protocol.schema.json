{
  "$id": "https://horisma.invalid/contracts/intermediate/0.1.0/project_protocol.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Structural interchange for dictionary entity project_protocol. Conformance does not certify review, truth, rights or implementation.",
  "properties": {
    "definition_stage": {
      "const": "CORE_CONTRACT_DEFINED"
    },
    "record": {
      "additionalProperties": false,
      "properties": {
        "approval_ref": {
          "anyOf": [
            {
              "$ref": "shared.schema.json#/$defs/RecordRef",
              "x-target-type": "review_decision"
            },
            {
              "type": "null"
            }
          ],
          "description": "Review of this protocol; absence is not approval.",
          "x-logical-type": "ref:review_decision"
        },
        "created_at": {
          "format": "date-time",
          "type": "string"
        },
        "created_by_actor_ref": {
          "$ref": "shared.schema.json#/$defs/RecordRef"
        },
        "dictionary_version": {
          "const": "0.1.0"
        },
        "disclosure_class": {
          "$ref": "shared.schema.json#/$defs/v_disclosure_class"
        },
        "entity_id": {
          "pattern": "^project_protocol:[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "type": "string"
        },
        "missing_reasons": {
          "additionalProperties": {
            "$ref": "shared.schema.json#/$defs/v_missing_reason"
          },
          "type": "object"
        },
        "policy_refs": {
          "description": "Applicable adjudication policies.",
          "items": {
            "$ref": "shared.schema.json#/$defs/RecordRef"
          },
          "minItems": 1,
          "type": "array",
          "x-logical-type": "refs:adjudication_policy",
          "x-target-type": "adjudication_policy"
        },
        "provenance_artifact_refs": {
          "items": {
            "$ref": "shared.schema.json#/$defs/RecordRef"
          },
          "type": "array"
        },
        "record_id": {
          "$ref": "shared.schema.json#/$defs/RecordRef"
        },
        "record_status": {
          "$ref": "shared.schema.json#/$defs/v_record_status"
        },
        "record_version": {
          "minimum": 1,
          "type": "integer"
        },
        "research_question_refs": {
          "description": "Questions covered by this protocol.",
          "items": {
            "$ref": "shared.schema.json#/$defs/RecordRef"
          },
          "minItems": 1,
          "type": "array",
          "x-logical-type": "refs:research_question",
          "x-target-type": "research_question"
        },
        "scope_statement": {
          "description": "Population, period, languages and exclusions; not universal coverage.",
          "minLength": 1,
          "type": "string",
          "x-logical-type": "text"
        },
        "supersedes_record_id": {
          "anyOf": [
            {
              "$ref": "shared.schema.json#/$defs/RecordRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "vocabulary_version": {
          "const": "0.1.0"
        }
      },
      "required": [
        "entity_id",
        "record_id",
        "record_version",
        "dictionary_version",
        "vocabulary_version",
        "record_status",
        "created_at",
        "created_by_actor_ref",
        "disclosure_class",
        "missing_reasons",
        "provenance_artifact_refs",
        "research_question_refs",
        "scope_statement",
        "policy_refs"
      ],
      "type": "object"
    },
    "record_type": {
      "const": "project_protocol"
    },
    "schema_profile": {
      "const": "horisma-dictionary-structural-0.1.0"
    }
  },
  "required": [
    "schema_profile",
    "record_type",
    "definition_stage",
    "record"
  ],
  "type": "object",
  "x-dictionary-sha256": "bfd1eaf0e8ba683e0aac0a5cbd0ffb77f455f6bb66d16160bd0906d2b6a96cd8",
