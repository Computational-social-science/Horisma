{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Horisma temporal event input 0.1.0",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_type",
        "date",
        "verification",
        "basis"
      ],
      "properties": {
        "event_type": {
          "enum": [
            "SOURCE_PUBLICATION",
            "SCHEDULED_PRESENTATION",
            "OCCURRENCE_CLAIM",
            "RETROSPECTIVE_ACKNOWLEDGMENT"
          ]
        },
        "date": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "precision",
            "value",
            "earliest",
            "latest",
            "calendar",
            "missing_reason"
          ],
          "properties": {
            "precision": {
              "enum": [
                "DAY",
                "MONTH",
                "YEAR",
                "INTERVAL",
                "UNKNOWN"
              ]
            },
            "value": {
              "type": [
                "string",
                "null"
              ]
            },
            "earliest": {
              "type": [
                "string",
                "null"
              ]
            },
            "latest": {
              "type": [
                "string",
                "null"
              ]
            },
            "calendar": {
              "enum": [
                "GREGORIAN",
                "UNRESOLVED"
              ]
            },
            "missing_reason": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "oneOf": [
            {
              "properties": {
                "precision": {
                  "const": "DAY"
                },
                "value": {
                  "type": "string",
                  "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                },
                "earliest": {
                  "type": "null"
                },
                "latest": {
                  "type": "null"
                },
                "calendar": {
                  "const": "GREGORIAN"
                },
                "missing_reason": {
                  "type": "null"
                }
              }
            },
            {
              "properties": {
                "precision": {
                  "const": "MONTH"
                },
                "value": {
                  "type": "string",
                  "pattern": "^\\d{4}-\\d{2}$"
                },
                "earliest": {
                  "type": "null"
                },
                "latest": {
                  "type": "null"
                },
                "calendar": {
                  "const": "GREGORIAN"
                },
                "missing_reason": {
                  "type": "null"
                }
              }
            },
            {
              "properties": {
                "precision": {
                  "const": "YEAR"
                },
                "value": {
                  "type": "string",
                  "pattern": "^\\d{4}$"
                },
                "earliest": {
                  "type": "null"
                },
                "latest": {
                  "type": "null"
                },
                "calendar": {
                  "const": "GREGORIAN"
                },
                "missing_reason": {
                  "type": "null"
                }
              }
            },
            {
              "properties": {
                "precision": {
                  "const": "INTERVAL"
                },
                "value": {
                  "type": "null"
                },
                "earliest": {
                  "type": "string",
                  "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                },
                "latest": {
                  "type": "string",
                  "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                },
                "calendar": {
                  "const": "GREGORIAN"
                },
                "missing_reason": {
                  "type": "null"
                }
              }
            },
            {
              "properties": {
                "precision": {
                  "const": "UNKNOWN"
                },
                "value": {
                  "type": "null"
                },
                "earliest": {
                  "type": "null"
                },
                "latest": {
                  "type": "null"
                },
                "missing_reason": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          ]
        },
        "verification": {
          "enum": [
            "PROVISIONAL",
            "REPORTED"
          ]
        },
        "basis": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_type",
        "date",
        "recorded_at"
      ],
      "properties": {
        "event_type": {
          "const": "SYSTEM_REVISION"
        },
        "date": {
          "type": "null"
        },
        "recorded_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  ]
}