{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "relation",
    "claim",
    "source",
    "passage",
    "rationale",
    "limitations",
    "qualification"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "relation": {
      "enum": [
        "REPORTS",
        "SUPPORTS",
        "CONTRADICTS",
        "LIMITS"
      ]
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "text",
        "sha256"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "revision",
        "sha256"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "passage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_id",
        "record_revision",
        "text",
        "sha256",
        "locator"
      ],
      "properties": {
        "record_id": {
          "type": "string",
          "minLength": 1
        },
        "record_revision": {
          "type": "string",
          "minLength": 1
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "minLength": 1
        },
        "locator": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "rationale": {
      "type": "string",
      "minLength": 1
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "qualification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "reason",
        "policy"
      ],
      "properties": {
        "status": {
          "const": "UNQUALIFIED"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "policy": {
          "const": "horisma-auto-review-0.1.0"
        }
      }
    }
  }
}