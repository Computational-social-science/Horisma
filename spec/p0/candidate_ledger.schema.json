{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:horisma:p0:candidate-ledger:1.0.0",
  "title": "Horisma P0 scholarly-claim intake projection, not accepted research records",
  "type": "object",
  "additionalProperties": false,
  "required": ["profile_version", "scope", "disclosure_class", "predicate_registry", "literature_sources", "candidates"],
  "properties": {
    "profile_version": {"const": "1.0.0"},
    "scope": {"const": "SCHOLARLY_CLAIM_CANDIDATES_NOT_GOLD"},
    "disclosure_class": {"const": "INTERNAL"},
    "predicate_registry": {
      "type": "object", "additionalProperties": false, "required": ["SOURCE_ASSERTS"],
      "properties": {"SOURCE_ASSERTS": {"type": "object", "additionalProperties": false, "required": ["arity", "signature", "interpretation"], "properties": {
        "arity": {"const": 2}, "signature": {"const": "DocumentVersion x CandidateClaim -> SourceReportingProposition"},
        "interpretation": {"type": "string", "minLength": 20}
      }}}
    },
    "literature_sources": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/source"}},
    "candidates": {"type": "array", "minItems": 20, "maxItems": 30, "items": {"$ref": "#/$defs/candidate"}}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["source_id", "title", "doi", "version_label", "media", "page_count", "relative_path", "sha256", "source_kind", "identity_status", "rights_status", "acquisition_receipt", "discovery_reference_anchor"],
      "properties": {
        "source_id": {"type": "string", "pattern": "^[A-Z0-9_-]+$"},
        "title": {"type": "string", "minLength": 3}, "doi": {"type": "string", "pattern": "^10\\."},
        "version_label": {"type": "string", "minLength": 3},
        "media": {"enum": ["pdf", "html"]}, "page_count": {"type": "integer", "minimum": 1, "maximum": 1000},
        "relative_path": {"type": "string", "pattern": "^data/intake/literature/"},
        "sha256": {"$ref": "#/$defs/digest"},
        "source_kind": {"type": "string"}, "identity_status": {"const": "UNVERIFIED"}, "rights_status": {"const": "NOT_REVIEWED"},
        "acquisition_receipt": {"type": "string"}, "discovery_reference_anchor": {"type": "string", "pattern": "^cite_note-"}
      }
    },
    "locator": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "source_sha256", "pdf_page_index", "region", "anchor_quote", "transcription_review_status", "derivative_receipt", "normalized_page_sha256", "text_start", "text_end", "context_start", "context_end"],
      "properties": {
        "kind": {"const": "PDF_PAGE_REGION"}, "source_sha256": {"$ref": "#/$defs/digest"},
        "pdf_page_index": {"type": "integer", "minimum": 0},
        "region": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "number", "minimum": 0, "maximum": 1}},
        "anchor_quote": {"type": "string", "minLength": 3}, "transcription_review_status": {"const": "PENDING"},
        "derivative_receipt": {"type": "string", "pattern": "^data/intake/literature/"},
        "normalized_page_sha256": {"$ref": "#/$defs/digest"},
        "text_start": {"type": "integer", "minimum": 0}, "text_end": {"type": "integer", "minimum": 1},
        "context_start": {"type": "integer", "minimum": 0}, "context_end": {"type": "integer", "minimum": 1}
      }
    },
    "candidate": {
      "type": "object", "additionalProperties": false,
      "required": ["candidate_id", "source_id", "proposition_en", "claim_class", "locator", "formalization", "qualification", "origin", "contribution_role", "explicit_exclusivity_asserted", "assessment", "review_status", "proof_status", "missing_reasons", "local_draft_receipt", "citation_trace_status", "proposal_provenance"],
      "properties": {
        "candidate_id": {"type": "string", "pattern": "^HC-P0-[0-9]{3}$"},
        "source_id": {"type": "string"}, "proposition_en": {"type": "string", "minLength": 8, "maxLength": 450},
        "claim_class": {"enum": ["ATTRIBUTION", "AUTHORSHIP", "THEORY", "METHOD", "OBSERVATION"]},
        "locator": {"$ref": "#/$defs/locator"},
        "formalization": {"type": "object", "additionalProperties": false, "required": ["predicate", "arguments"], "properties": {
          "predicate": {"const": "SOURCE_ASSERTS"}, "arguments": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "string"}}
        }},
        "qualification": {"type": "string", "minLength": 8}, "origin": {"const": "MODEL_PROPOSED"},
        "contribution_role": {"type": ["string", "null"]}, "explicit_exclusivity_asserted": {"type": "boolean"},
        "assessment": {"type": "null"}, "review_status": {"const": "PENDING"}, "proof_status": {"const": "UNPROVEN"},
        "missing_reasons": {"type": "object", "additionalProperties": false, "required": ["assessment"], "properties": {
          "assessment": {"const": "NOT_ASSESSED"}, "contribution_role": {"enum": ["NOT_APPLICABLE", "NOT_ASSESSED"]}
        }},
        "local_draft_receipt": {"type": "string", "pattern": "^data/intake/literature/"},
        "citation_trace_status": {"const": "NOT_COLLECTED"},
        "proposal_provenance": {"const": "MAIN_MODEL_CURATED_FROM_SCHOLARLY_BODY_LOCAL_PARSE; LOCAL_REWRITES_NOT_ACCEPTED"}
      }
    }
  }
}
